# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================

# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Security Settings (Production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
DJANGO_SECURE_REFERRER_POLICY=strict-origin-when-cross-origin
DJANGO_X_FRAME_OPTIONS=DENY

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Option 1: PostgreSQL (Production)
POSTGRES_DB=registrar_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Option 2: SQLite (Development)
# DATABASE_URL=sqlite:///db.sqlite3

# =============================================================================
# UNISTUDIO BOT CONFIGURATION
# =============================================================================

# OpenAI API Configuration (Required)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Bot Webhook Secret
UNISTUDIO_BOT_WEBHOOK_SECRET=unistudio_bot_secret_2026

# =============================================================================
# 🔒 SECURITY INSTRUCTIONS
# =============================================================================

# 1. NEVER commit this file with real API keys
# 2. ALWAYS replace placeholder values before use
# 3. Add .env to .gitignore to prevent accidental commits
# 4. Use different API keys for development/staging/production
# 5. Rotate keys if compromised
# 6. Use secure key management platforms (1Password, LastPass, Bitwarden)

# =============================================================================
# AI INSIGHTS CONFIGURATION (Optional)
# =============================================================================

# OpenAI Insights
OPENAI_INSIGHTS_ENABLED=False
OPENAI_INSIGHTS_MODEL=gpt-5.4-mini
OPENAI_INSIGHTS_TIMEOUT_SECONDS=6

# Google Insights
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_INSIGHTS_MODEL=gemini-2.5-flash-lite
GOOGLE_INSIGHTS_TIMEOUT_SECONDS=6

# =============================================================================
# AUTHENTICATION SETTINGS
# =============================================================================

AUTH_LOCKOUT_FAILURE_LIMIT=5
AUTH_LOCKOUT_DURATION_MINUTES=15
LOGIN_BYPASS_DOMAINS=

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# For development, you can use:
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=django-insecure-dev-key
# DATABASE_URL=sqlite:///db.sqlite3
